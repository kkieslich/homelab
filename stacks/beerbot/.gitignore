# Runtime secrets live here as sops-encrypted enc.env (committed, safe). Komodo's
# pre_deploy decrypts it to a gitignored .env on the host at deploy time.
*.env
!enc.env
!*.env.example

# Same pattern for the FCM key: fcm-api.json.enc is committed (encrypted, safe);
# pre_deploy decrypts it to a gitignored fcm-api.json on the host. Never commit the
# decrypted key.
fcm-api.json

# The Keycloak realm is owned by the BeerBot repo and baked into the Keycloak
# image; pre_deploy extracts it here at deploy time. A committed copy is what let
# the two files drift apart before — keep it untracked so there is exactly one
# source of truth.
scripts/keycloak/beerbot-realm.json
