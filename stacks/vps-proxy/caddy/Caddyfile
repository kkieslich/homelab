# Caddy on the beerbot VPS. Every backend shares proxy_net with caddy and is
# routed by service name. The old (pre-Expo) beerbot.app hostnames get added
# here when that instance moves over.

# --- beerbot (routed by service name over proxy_net; no host ports) ---
beerbot.home.kki.berlin {
    encode gzip zstd
    reverse_proxy beerbot-web:80
}

api.beerbot.home.kki.berlin {
    encode gzip zstd
    reverse_proxy beerbot-api:80
}

auth.beerbot.home.kki.berlin {
    encode gzip zstd
    reverse_proxy beerbot-keycloak:8080
}

admin.beerbot.home.kki.berlin {
    encode gzip zstd
    # /api/* → admin API with the /api prefix stripped (handle_path); everything
    # else → the admin SPA.
    handle_path /api/* {
        reverse_proxy beerbot-admin-api:80
    }
    handle {
        reverse_proxy beerbot-admin-web:80
    }
}

cdn.beerbot.home.kki.berlin {
    encode gzip zstd
    reverse_proxy beerbot-s3:3900
}

www.beerbot.home.kki.berlin {
    encode gzip zstd
    reverse_proxy beerbot-landing:80
}

# --- old (pre-Expo) beerbot, stacks/beerbot-legacy ---
beerbot.app {
    encode gzip zstd
    # The old Traefik set these on the landing page; kept for parity.
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET,OPTIONS,PUT"
    header Access-Control-Max-Age "100"
    header Vary "Origin"
    reverse_proxy beerbot-legacy-landing:80
}

api.beerbot.app {
    encode gzip zstd
    reverse_proxy beerbot-legacy-api:80
}

auth.beerbot.app {
    encode gzip zstd
    reverse_proxy beerbot-legacy-auth:80
}

# Web version of the old app. Was unreachable for a long time because the DNS
# record was missing.
open.beerbot.app {
    encode gzip zstd
    reverse_proxy beerbot-legacy-open:80
}
